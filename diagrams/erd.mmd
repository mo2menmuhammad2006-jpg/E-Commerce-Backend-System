erDiagram

    %% --- USER & ACCESS DOMAIN ---
    USERS |o--o{ ORDERS : "places"
    USERS ||--o{ REVIEWS : "writes"
    USERS |o--|o CARTS : "owns"
    USERS |o--o{ AUDIT_LOGS : "performs"
    USERS |o--o{ ORDER_LOGS : "performs"

    %% --- CATALOG DOMAIN ---
    CATEGORIES |o--o{ CATEGORIES : "parent of"
    CATEGORIES ||--o{ PRODUCTS : "contains"
    PRODUCTS ||--o{ PRODUCT_IMAGES : "has"
    PRODUCTS ||--|{ PRODUCT_VARIANTS : "has"
    PRODUCTS ||--o{ REVIEWS : "receives"
    PRODUCT_VARIANTS ||--o{ PRICE_LOGS : "tracks"

    %% --- INVENTORY DOMAIN ---
    PRODUCT_VARIANTS ||--o| INVENTORY : "has stock"
    INVENTORY ||--o{ INVENTORY_LOGS : "logs changes"

    %% --- CART DOMAIN ---
    CARTS ||--o{ CART_ITEMS : "contains"
    PRODUCT_VARIANTS ||--o{ CART_ITEMS : "added to"

    %% --- ORDER DOMAIN ---
    ORDERS ||--|{ ORDER_ITEMS : "contains"
    ORDERS ||--o{ ORDER_LOGS : "tracks"
    ORDERS ||--o{ REVIEWS : "verified purchase"
    PRODUCT_VARIANTS ||--o{ ORDER_ITEMS : "sold in"

    %% --- ENTITY DEFINITIONS ---

    USERS {
        uuid id PK
        string email UK
        string password_hash
        string first_name
        string last_name
        string phone "nullable"
        string role "CUSTOMER, ADMIN"
        boolean is_active "default true"
        timestamp created_at
        timestamp updated_at
    }

    PRODUCTS {
        uuid id PK
        string name UK
        text description
        string status "DRAFT, ACTIVE, INACTIVE"
        uuid category_id FK
        timestamp created_at
        timestamp updated_at
    }

    CATEGORIES {
        uuid id PK
        string name
        text description
        uuid parent_id FK "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PRODUCT_IMAGES {
        uuid id PK
        uuid product_id FK
        string url
        string alt_text
        int display_order
        boolean is_primary
        timestamp created_at
        timestamp updated_at
    }

    PRODUCT_VARIANTS {
        uuid id PK
        uuid product_id FK
        string sku UK
        decimal price
        jsonb attributes "PostgreSQL JSONB for specs"
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    INVENTORY {
        uuid id PK
        uuid variant_id FK
        int total_quantity
        int low_stock_threshold
        timestamp last_updated
        timestamp created_at
    }

    INVENTORY_LOGS {
        uuid id PK
        uuid inventory_id FK
        string operation_type
        int previous_quantity
        int new_quantity
        string reason
        timestamp created_at
    }

    CARTS {
        uuid id PK
        uuid user_id FK "unique,nullable"
        string session_id UK "nullable"
        timestamp created_at
        timestamp updated_at
    }

    CART_ITEMS {
        uuid id PK
        uuid cart_id FK
        uuid variant_id FK
        int quantity
        decimal price_at_addition
        timestamp added_at
        timestamp updated_at
    }

    ORDERS {
        uuid id PK
        string order_number UK
        uuid user_id FK "nullable for guest checkout"
        string status "PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED"
        string customer_name
        string customer_email
        string customer_phone
        string shipping_full_name
        string shipping_street
        string shipping_city
        string shipping_state
        string shipping_postal_code
        string shipping_country_code
        decimal subtotal
        decimal shipping_cost
        decimal tax_amount
        decimal total_amount
        timestamp created_at
        timestamp updated_at
    }

    ORDER_ITEMS {
        uuid id PK
        uuid order_id FK
        uuid variant_id FK
        string product_name "Snapshot"
        jsonb variant_attributes "Snapshot"
        decimal unit_price "Snapshot"
        int quantity
        decimal total_price "Snapshot"
        timestamp created_at
    }

    ORDER_LOGS {
        uuid id PK
        uuid order_id FK
        string from_status "nullable"
        string to_status
        string reason 
        string performed_by_type "USER, GUEST, SYSTEM"
        uuid performed_by FK "nullable: NULL = GUEST or SYSTEM"
        timestamp created_at
    }

    REVIEWS {
        uuid id PK
        uuid user_id FK
        uuid product_id FK
        uuid order_id FK
        int rating "min 1 max 5"
        string title
        text body
        string status "PENDING, APPROVED, REJECTED"
        string moderation_notes "nullable"
        timestamp moderated_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PRICE_LOGS {
        uuid id PK
        uuid variant_id FK
        decimal old_price
        decimal new_price
        timestamp created_at
    }

    STORE_SETTINGS {
        bigint id PK
        string base_currency
        string currency_symbol
        decimal flat_rate_shipping
        decimal free_shipping_threshold
        decimal tax_rate_percent
        timestamp updated_at
    }

    AUDIT_LOGS {
        uuid id PK
        string entity_type
        uuid entity_id
        string action
        uuid performed_by FK "nullable: NULL = SYSTEM"
        string performed_by_type "USER, SYSTEM"
        jsonb changes "PostgreSQL JSONB"
        timestamp created_at
    }

